# Frontend build-time configuration. Everything here is embedded in public JavaScript:
# NEVER put API keys or other secrets in a VITE_ variable.

# Base URL of the API. Leave empty in development (Vite proxies /api to the backend).
# Set to the Lambda Function URL (no trailing slash) for a production build.
VITE_API_BASE_URL=

# Dev-server only (not exposed to the browser): where Vite forwards /api requests.
# API_PROXY_TARGET=http://127.0.0.1:8000
