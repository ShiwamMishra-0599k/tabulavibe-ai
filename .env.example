# TabulaVibe AI configuration. NO REAL SECRETS IN THIS FILE.
#
# Backend: copy this file to backend/.env (gitignored) and edit. Every variable is optional;
# the defaults below are what the app uses when a variable is not set.
# Frontend: see frontend/.env.example (only public, build-time values belong there).

# development | test | production  (production hides /api/docs)
TABULAVIBE_APP_ENV=development

# Exact origins allowed by CORS, comma-separated. "*" is ignored on purpose.
TABULAVIBE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits. The engine keeps the whole file in memory: peak memory is about 14x the CSV size
# (100 MB CSV ≈ 1.8 GB, ~45 s per action on an 8 GB laptop). Raise only on machines with more memory.
# On Vercel the upload limit defaults to 3.5 MB (platform cap 4.5 MB); the AWS template sets 4 MB.
TABULAVIBE_MAX_UPLOAD_MB=100
# Excel is read ~10x slower than CSV, so it has a separate limit (save large sheets as CSV).
TABULAVIBE_MAX_XLSX_MB=20
TABULAVIBE_MAX_ROWS=2000000
TABULAVIBE_MAX_COLUMNS=200
TABULAVIBE_MAX_CELLS=20000000
# Files larger than this are processed one at a time.
TABULAVIBE_LARGE_FILE_MB=25
TABULAVIBE_MAX_GROUPS=100

# Optional AI (commentary and the AI Analyst). Disabled by default; every other feature works without it.
# TABULAVIBE_AI_PROVIDER is "none" or the order to try providers, e.g. "groq,nvidia": Groq first, and NVIDIA
# continues the same run when Groq cannot (Groq's free plan is usually too small for an analyst request).
# Keys: Groq from console.groq.com, NVIDIA (nvapi-) from build.nvidia.com. Models must support tool calling.
# Only aggregated results are ever sent, never raw rows.
TABULAVIBE_AI_PROVIDER=none
TABULAVIBE_GROQ_API_KEY=
TABULAVIBE_GROQ_MODEL=openai/gpt-oss-120b
TABULAVIBE_NVIDIA_API_KEY=
TABULAVIBE_NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Groq's per-minute token budget (8000 on the free plan): larger requests go straight to NVIDIA.
TABULAVIBE_GROQ_TOKENS_PER_MINUTE=8000
# Seconds to wait for one AI reply in the analyst and Ask AI (free endpoints can be slow).
TABULAVIBE_AGENT_REQUEST_TIMEOUT_SECONDS=90
# Predictive forecast of the AI Analyst's primary measure with NVIDIA Kumo Relational (uses the NVIDIA key).
# Sends period totals only (never raw rows); NVIDIA's trial terms allow it to record inputs.
TABULAVIBE_FORECAST_PROVIDER=none
# "Ask AI" chat questions per user (or IP) per minute.
TABULAVIBE_CHAT_QUESTIONS_PER_MINUTE=8
TABULAVIBE_AI_TIMEOUT_SECONDS=20
TABULAVIBE_AI_REQUESTS_PER_MINUTE=5

# Optional sign-in (Google / GitHub) and saved reports, using Supabase. Disabled while empty.
# Supabase dashboard → Project Settings → API: copy the Project URL and the anon / publishable key.
# The anon key is public by design (Row Level Security protects the data). NEVER put the
# service_role / secret key here: the backend refuses to start with it.
# Then run supabase/migrations/*.sql in the SQL Editor (see docs/SUPABASE_SETUP.md).
TABULAVIBE_SUPABASE_URL=
TABULAVIBE_SUPABASE_ANON_KEY=
TABULAVIBE_SUPABASE_TIMEOUT_SECONDS=10
# true = every upload/analysis request needs a signed-in user (enforced by the backend).
# Requires the two Supabase values above; the backend refuses to start otherwise.
TABULAVIBE_REQUIRE_SIGN_IN=false

# GitHub repository ("owner/name") whose star count appears in the navigation bar. Leave empty to hide it.
# The server fetches the public count (no token) and caches it for 10 minutes.
TABULAVIBE_GITHUB_REPO=ShiwamMishra-0599k/tabulavibe-ai
